# Supabase project (public URL and publishable/anon key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose these with NEXT_PUBLIC_ prefixes.
SUPABASE_SERVICE_ROLE_KEY=

# Required for AES-256-GCM encryption of merchant payment credentials.
# Generate 32 random bytes, base64 encode, and store only in a secret manager.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=

# Optional public base URL for payment callback URLs when integrations are enabled.
APP_BASE_URL=
